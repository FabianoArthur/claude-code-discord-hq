# claude-code-discord-hq settings.
#
# Copy this file to ~/.config/claude-code-discord-hq/.env (install.sh does it
# for you, with mode 0600) and fill in what you need. Real environment
# variables override this file. NEVER commit the filled-in copy.

# --- Server as code (`discord-hq plan` / `discord-hq apply`) -----------------

# Token of a TEMPORARY admin bot used only to apply the design.
# Revoke it (Developer Portal -> Bot -> Reset Token) right after `apply`.
DISCORD_HQ_ADMIN_TOKEN=

# Your server (guild) id: Discord -> Settings -> Advanced -> Developer Mode,
# then right-click the server icon -> Copy Server ID.
DISCORD_HQ_GUILD_ID=

# Path to your design file (default: ./design.toml). The --design flag wins.
DISCORD_HQ_DESIGN=

# Where `apply` keeps the ids it manages (default: state.json next to the
# design file). Ids and names only, never secrets; still git-ignored.
DISCORD_HQ_STATE=

# --- Notifications (`discord-hq hook` / `discord-hq watch`) ------------------

# Your own Discord user id, mentioned on alerts. Leave empty for no mention.
DISCORD_HQ_MENTION_USER_ID=

# Names of the webhooks (as declared in the design) used for each kind of
# alert. Their URLs live in ~/.config/claude-code-discord-hq/webhooks.json
# (created by `apply`, mode 0600).
DISCORD_HQ_WEBHOOK_READY=Pass
DISCORD_HQ_WEBHOOK_ALERT=Bell
DISCORD_HQ_WEBHOOK_PANEL=Panel

# How kitchen sessions are recognised: tmux session name prefix, the folder
# that holds git worktrees, the per-worktree marker folder (".../done" means
# "PR opened"), and where the batch manifests live.
DISCORD_HQ_SESSION_PREFIX=kitchen-
DISCORD_HQ_WORKTREES_DIR=.worktrees
DISCORD_HQ_MARKER_DIR=.kitchen
DISCORD_HQ_MANIFEST_GLOB=docs/plans/*-manifest.md

# Minutes without transcript progress before a "working" session is stalled.
DISCORD_HQ_STALL_MINUTES=10

# How to call the GitHub CLI (e.g. "env -u GH_TOKEN gh" if a stale GH_TOKEN
# shadows your keyring login).
DISCORD_HQ_GH=gh

# macOS only: what clicking a notification runs. {attach} is replaced by the
# tmux attach command. Example for Ghostty: open -na Ghostty --args -e {attach}
DISCORD_HQ_CLICK_COMMAND=open -a Terminal

# Override where settings are read from (default: $XDG_CONFIG_HOME or
# ~/.config, plus /claude-code-discord-hq).
# DISCORD_HQ_CONFIG_DIR=
